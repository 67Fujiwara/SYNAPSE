{
  "name": "synapse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SYNAPSE — Wire your brain for English. Speaking trainer for electrical/controls engineers.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"wrangler dev --port 8787\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply synapse-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply synapse-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "preview:worker": "npm run build && wrangler dev --port 8787"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "framer-motion": "^12.23.0",
    "hono": "^4.13.0",
    "lucide-react": "^1.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.151.0"
  }
}
